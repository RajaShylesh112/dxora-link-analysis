OPENROUTER_API_KEY=
# Only free models are allowed by this implementation.
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
# Optional alternate free model. Leave empty to avoid a second request.
OPENROUTER_FALLBACK_MODEL=
# Set to true only for a model/provider supporting JSON Schema.
LLM_STRICT_SCHEMA=true
LLM_DISABLE_REASONING=true
# Optional shared key for a private deployment. Empty = public reviewer demo.
ANALYSIS_API_KEY=
FETCH_TIMEOUT_SECONDS=12
LLM_TIMEOUT_SECONDS=100
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=64
MAX_PAGES=3
MAX_HTML_BYTES=1500000
MAX_CONTENT_CHARS=22000
REQUESTS_PER_MINUTE=6
MAX_CONCURRENT_ANALYSES=2
